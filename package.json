{
  "name": "smart-form-autofilling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspace=smart-form-frontend",
    "lint": "eslint frontend extension && prettier --check \"*.{json,yml}\" \"frontend/**/*.{js,jsx,css,html,json}\" \"extension/**/*.{js,css,html,json}\"",
    "format": "prettier --write \"*.{json,yml}\" \"frontend/**/*.{js,jsx,css,html,json}\" \"extension/**/*.{js,css,html,json}\"",
    "test": "python -m pytest backend/tests tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
