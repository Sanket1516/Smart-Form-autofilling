digraph G { rankdir=TB; 
  graph [fontname="Times New Roman,", fontsize=17, pad=0.15, nodesep=0.28, ranksep=0.42, newrank=true];
  node  [fontname="Times New Roman,", fontsize=17, style="filled,rounded", shape=box, penwidth=1.4, margin="0.12,0.06", fillcolor="#FFFFFF", color="#333333"];
  edge  [fontname="Times New Roman,", fontsize=15, penwidth=1.3, arrowsize=0.8, color="#333333"];

  graph [nodesep=0.22, ranksep=0.36];
  subgraph cluster_c { label="1. Clients"; labeljust=l; fontname="Times New Roman, Bold"; style="rounded,filled"; fillcolor="#DCE9F8"; color="#2F5D9B";
    dash [label="Web dashboard
(React)"];
    ext [label="Chrome extension
(popup + content
script)"];
    form [label="Web form on
any website", fillcolor="#EFEFEF"];
  }
  api [label="2. FastAPI backend: REST API, JWT login,
rate limits, per-user data isolation", fillcolor="#F8DCDC", color="#A33A3A"];
  subgraph cluster_a { label="3. Document ingestion (background)"; labeljust=l; fontname="Times New Roman, Bold"; style="rounded,filled"; fillcolor="#DDEFE0"; color="#3C7A4B";
    q [label="Redis queue →
Celery worker"];
    p1 [label="Read text
(RapidOCR
for images)"];
    p2 [label="Identify
document type
(17 types)"];
    p3 [label="Extract facts
(rules + optional
LLM)"];
    p4 [label="Merge; keep
page and
evidence"];
    p5 [label="Chunk text;
embed
(MiniLM)"];
  }
  subgraph cluster_d { label="4. Storage"; labeljust=l; fontname="Times New Roman, Bold"; style="rounded,filled"; fillcolor="#FBEBCB"; color="#A8741A";
    files [label="File
storage", shape=cylinder, style=filled, fillcolor="#FFFFFF"];
    mongo [label="MongoDB
(facts,
sessions)", shape=cylinder, style=filled, fillcolor="#FFFFFF"];
    chroma [label="ChromaDB
(chunk
vectors)", shape=cylinder, style=filled, fillcolor="#FFFFFF"];
  }
  subgraph cluster_u { label="5. Using the stored data"; labeljust=l; fontname="Times New Roman, Bold"; style="rounded,filled"; fillcolor="#E9E1F2"; color="#6B4E9B";
    qa [label="Ask Documents:
exact facts +
semantic search
→ cited answer"];
    llm [label="LLM provider
(Gemini or
local model)", style="filled,rounded,dashed", fillcolor="#EFEFEF"];
    lg [label="Form-fill LangGraph:
classify fields →
resolve from profile
→ evidence → decide"];
  }
  review [label="6. Popup review: the user approves each value;
approved values are filled into the form and
read back to verify; the form is never submitted", fillcolor="#DCE9F8", color="#2F5D9B"];

  {rank=same; dash; ext; form}
  form -> ext [label=" scan", constraint=false];
  dash -> api [label=" upload,
 ask"]; ext -> api [label=" analyze"];
  api -> q [label=" new document"];
  {rank=same; q; p1; p2}
  {rank=same; p3; p4; p5}
  q -> p1 -> p2; p2 -> p3 [constraint=false]; p3 -> p4 -> p5;
  q -> p3 [style=invis]; p1 -> p4 [style=invis]; p2 -> p5 [style=invis];
  {rank=same; files; mongo; chroma}
  files -> p1 [style=dashed, constraint=false];
  p4 -> mongo [label=" facts"]; p5 -> chroma [label=" vectors"];
  p3 -> files [style=invis];
  {rank=same; qa; llm; lg}
  mongo -> qa; chroma -> qa; mongo -> lg [label=" profile"]; chroma -> lg [label=" evidence"];
  qa -> llm [style=dashed, dir=both, constraint=false]; llm -> lg [style=dashed, dir=both, constraint=false];
  lg -> review [label=" recommendations"]; qa -> review [style=invis];
}