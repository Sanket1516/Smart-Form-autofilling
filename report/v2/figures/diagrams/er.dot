digraph G {
  graph [fontname="Times New Roman,", fontsize=16, pad=0.2, rankdir=LR, nodesep=0.2, ranksep=0.7];
  node  [fontname="Times New Roman,", fontsize=16, style="filled,rounded", shape=box, penwidth=1.5, margin="0.14,0.08"];
  edge  [fontname="Times New Roman,", fontsize=14, penwidth=1.4, arrowsize=0.8];
  users [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5D9B" BGCOLOR="#DCE9F8"><TR><TD BGCOLOR="#2F5D9B"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B></TD></TR><TR><TD ALIGN="LEFT">full_name, email (unique)</TD></TR><TR><TD ALIGN="LEFT">password_hash, status</TD></TR><TR><TD ALIGN="LEFT">created_at, last_login_at</TD></TR></TABLE>>];
  auth_token_revocations [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A33A3A" BGCOLOR="#F8DCDC"><TR><TD BGCOLOR="#A33A3A"><FONT COLOR="white"><B>auth_token_revocations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>jti</B> (unique)</TD></TR><TR><TD ALIGN="LEFT">expires_at (TTL)</TD></TR></TABLE>>];
  documents [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">file_name, file_type, file_size</TD></TR><TR><TD ALIGN="LEFT">checksum (unique per user)</TD></TR><TR><TD ALIGN="LEFT">status, current_stage, progress</TD></TR><TR><TD ALIGN="LEFT">fact_count, index_status, chunk_count</TD></TR><TR><TD ALIGN="LEFT">storage_reference</TD></TR></TABLE>>];
  processing_records [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>processing_records</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B></TD></TR><TR><TD ALIGN="LEFT">user_id, document_id (FK)</TD></TR><TR><TD ALIGN="LEFT">stage, status, retry_count</TD></TR></TABLE>>];
  structured_facts [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>structured_facts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">source_document_id (FK or user)</TD></TR><TR><TD ALIGN="LEFT">concept, value, raw_value</TD></TR><TR><TD ALIGN="LEFT">origin, status, method</TD></TR><TR><TD ALIGN="LEFT">confidence, evidence_text</TD></TR><TR><TD ALIGN="LEFT">source_page, is_user_confirmed</TD></TR></TABLE>>];
  discovered_facts [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>discovered_facts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">source_document_id (FK)</TD></TR><TR><TD ALIGN="LEFT">field, semantic_type, value</TD></TR><TR><TD ALIGN="LEFT">ontology, confidence, origin</TD></TR></TABLE>>];
  form_sessions [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5D9B" BGCOLOR="#DCE9F8"><TR><TD BGCOLOR="#2F5D9B"><FONT COLOR="white"><B>form_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">website_origin, page_url, form_id</TD></TR><TR><TD ALIGN="LEFT">status, started_at</TD></TR><TR><TD ALIGN="LEFT">field counters, fill_results[]</TD></TR></TABLE>>];
  recommendations [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5D9B" BGCOLOR="#DCE9F8"><TR><TD BGCOLOR="#2F5D9B"><FONT COLOR="white"><B>recommendations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">session_id (FK), field_id</TD></TR><TR><TD ALIGN="LEFT">concept, recommended_value</TD></TR><TR><TD ALIGN="LEFT">status, confidence, reason</TD></TR><TR><TD ALIGN="LEFT">requires_confirmation, candidates[]</TD></TR></TABLE>>];
  corrections [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>corrections</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">concept, original, corrected</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR></TABLE>>];
  user_memories [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#555555"><FONT COLOR="white"><B>user_memories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>_id</B>, user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">label, concept, value, indexed</TD></TR></TABLE>>];
  chroma_chunk [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B4E9B" BGCOLOR="#E9E1F2"><TR><TD BGCOLOR="#6B4E9B"><FONT COLOR="white"><B>chroma_chunk</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>chunk_id</B></TD></TR><TR><TD ALIGN="LEFT">text, 384-dim embedding</TD></TR><TR><TD ALIGN="LEFT">user_id, document_id</TD></TR><TR><TD ALIGN="LEFT">page_number, chunk_index</TD></TR><TR><TD ALIGN="LEFT">source_type, document_type</TD></TR></TABLE>>];
  users -> documents [label=" 1:N"]; users -> form_sessions [label=" 1:N"]; users -> structured_facts [label=" 1:N"];
  users -> corrections; users -> user_memories; users -> auth_token_revocations [style=dashed, label=" jti"];
  documents -> structured_facts [label=" 1:N"]; documents -> discovered_facts; documents -> processing_records;
  documents -> chroma_chunk [style=dashed, label=" 1:N (index)"]; form_sessions -> recommendations [label=" 1:N"];
  user_memories -> chroma_chunk [style=dashed];
}
