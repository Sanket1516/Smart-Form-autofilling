digraph G {
  graph [fontname="Arial", fontsize=16, pad=0.2, rankdir=TB, nodesep=0.3, ranksep=0.6];
  node  [fontname="Arial", fontsize=16, style="filled,rounded", shape=box, penwidth=1.5, margin="0.14,0.08"];
  edge  [fontname="Arial", fontsize=14, penwidth=1.4, arrowsize=0.8];
  FormFillGraph [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FormFillGraph</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- classifier: FieldClassifier<BR ALIGN="LEFT"/>- facts: FactService<BR ALIGN="LEFT"/>- retrieval: RAGRetrievalService<BR ALIGN="LEFT"/>- llm: LLMProvider<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run(user_id, session_id, fields)<BR ALIGN="LEFT"/>- _sanitize()<BR ALIGN="LEFT"/>- _deterministic_classify()<BR ALIGN="LEFT"/>- _llm_classify()<BR ALIGN="LEFT"/>- _resolve_profile()<BR ALIGN="LEFT"/>- _resolve_documents()<BR ALIGN="LEFT"/>- _decide()<BR ALIGN="LEFT"/>- _persist()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FieldClassifier [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FieldClassifier</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ontology: FieldOntology<BR ALIGN="LEFT"/>- threshold: float<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classify_deterministic(field)<BR ALIGN="LEFT"/>+ classify_with_llm(fields, prior)<BR ALIGN="LEFT"/>+ is_resolved(c)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FactService [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FactService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ resolve_view(user_id)<BR ALIGN="LEFT"/>+ list_conflicts(user_id)<BR ALIGN="LEFT"/>+ resolve_conflict(...)<BR ALIGN="LEFT"/>+ add_user_fact(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FieldOntology [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FieldOntology</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- concepts (91)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ match_text(text)<BR ALIGN="LEFT"/>+ concept_for_autocomplete(t)<BR ALIGN="LEFT"/>+ is_sensitive(c)<BR ALIGN="LEFT"/>+ is_fillable(c)<BR ALIGN="LEFT"/>+ is_single_valued(c)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ConceptView [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>ConceptView</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: resolved | conflict | multiple<BR ALIGN="LEFT"/>+ value, confidence, origin<BR ALIGN="LEFT"/>+ candidates, sources<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  StructuredFact [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>StructuredFact</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ concept, value, raw_value<BR ALIGN="LEFT"/>+ origin, status, confidence<BR ALIGN="LEFT"/>+ source_document_id, source_page<BR ALIGN="LEFT"/>+ evidence_text, is_user_confirmed<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  FormFillGraph -> FieldClassifier [arrowhead=diamond]; FormFillGraph -> FactService [arrowhead=diamond];
  FieldClassifier -> FieldOntology [arrowhead=diamond]; FactService -> FieldOntology [arrowhead=diamond];
  FactService -> StructuredFact [label=" 1..*", arrowhead=open]; FactService -> ConceptView [style=dashed, label=" creates"];
}
