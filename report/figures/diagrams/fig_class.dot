digraph G {
  graph [fontname="Arial", fontsize=14, pad=0.25, rankdir=TB, nodesep=0.2, ranksep=0.55];
  node  [fontname="Arial", fontsize=15, style="filled,rounded", shape=box, penwidth=1.4, margin="0.16,0.09"];
  edge  [fontname="Arial", fontsize=13, penwidth=1.3, arrowsize=0.8];
  FormFillGraph [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FormFillGraph</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- settings: Settings<BR ALIGN="LEFT"/>- classifier: FieldClassifier<BR ALIGN="LEFT"/>- facts: FactService<BR ALIGN="LEFT"/>- retrieval: RAGRetrievalService<BR ALIGN="LEFT"/>- llm: LLMProvider<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run(user_id, session_id, fields)<BR ALIGN="LEFT"/>- _sanitize() / _deterministic_classify()<BR ALIGN="LEFT"/>- _llm_classify() / _resolve_profile()<BR ALIGN="LEFT"/>- _resolve_documents() / _decide() / _persist()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FieldClassifier [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FieldClassifier</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ontology: FieldOntology<BR ALIGN="LEFT"/>- threshold: float<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ classify_deterministic(field)<BR ALIGN="LEFT"/>+ classify_with_llm(fields, prior)<BR ALIGN="LEFT"/>+ is_resolved(c)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FactService [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FactService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- repository: StructuredFactsRepository<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ resolve_view(user_id)<BR ALIGN="LEFT"/>+ list_conflicts(user_id)<BR ALIGN="LEFT"/>+ resolve_conflict(...)<BR ALIGN="LEFT"/>+ add_user_fact(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FieldOntology [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>FieldOntology</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- concepts: 91<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ match_text(text)<BR ALIGN="LEFT"/>+ concept_for_autocomplete(t)<BR ALIGN="LEFT"/>+ is_sensitive(c) / is_fillable(c)<BR ALIGN="LEFT"/>+ is_single_valued(c)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LLMProvider [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B4E9B" BGCOLOR="#E9E1F2"><TR><TD BGCOLOR="#6B4E9B"><FONT COLOR="white"><B>LLMProvider</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ acomplete(prompt, system, task)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Providers [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6B4E9B" BGCOLOR="#E9E1F2"><TR><TD BGCOLOR="#6B4E9B"><FONT COLOR="white"><B>Providers</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GoogleProvider<BR ALIGN="LEFT"/>OpenAIProvider<BR ALIGN="LEFT"/>AnthropicProvider<BR ALIGN="LEFT"/>MockLLMProvider<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  DocumentPipeline [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>DocumentPipeline</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- extractor, deterministic<BR ALIGN="LEFT"/>- llm_extractor, chunker<BR ALIGN="LEFT"/>- embeddings, vector_store<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ run(user_id, document_id, path, name, on_update)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RAGRetrievalService [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3C7A4B" BGCOLOR="#DDEFE0"><TR><TD BGCOLOR="#3C7A4B"><FONT COLOR="white"><B>RAGRetrievalService</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- min_similarity: float<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ search(user_id, query, top_k)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  StructuredFact [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>StructuredFact</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ concept, value, raw_value<BR ALIGN="LEFT"/>+ origin, status, confidence<BR ALIGN="LEFT"/>+ source_document_id, source_page<BR ALIGN="LEFT"/>+ evidence_text, is_user_confirmed<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  ConceptView [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#A8741A" BGCOLOR="#FBEBCB"><TR><TD BGCOLOR="#A8741A"><FONT COLOR="white"><B>ConceptView</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: resolved|conflict|multiple<BR ALIGN="LEFT"/>+ value, confidence, origin<BR ALIGN="LEFT"/>+ candidates, sources<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  FieldObject [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F5D9B" BGCOLOR="#DCE9F8"><TR><TD BGCOLOR="#2F5D9B"><FONT COLOR="white"><B>FieldObject</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ field_id, input_type, label<BR ALIGN="LEFT"/>+ name, id, placeholder, section<BR ALIGN="LEFT"/>+ options[], has_value<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  FormFillGraph -> FieldClassifier [arrowhead=diamond, label=" uses"]; FormFillGraph -> FactService [arrowhead=diamond]; FormFillGraph -> RAGRetrievalService [arrowhead=diamond]; FormFillGraph -> LLMProvider [arrowhead=diamond];
  FieldClassifier -> FieldOntology [arrowhead=diamond]; FactService -> FieldOntology [arrowhead=diamond]; FactService -> StructuredFact [label="1..*", arrowhead=open]; FactService -> ConceptView [style=dashed, label="creates"];
  GoogleProvider -> LLMProvider [arrowhead=empty]; OpenAIProvider -> LLMProvider [arrowhead=empty]; AnthropicProvider -> LLMProvider [arrowhead=empty]; MockLLMProvider -> LLMProvider [arrowhead=empty];
  DocumentPipeline -> FieldOntology [arrowhead=diamond]; DocumentPipeline -> LLMProvider [style=invis]; FormFillGraph -> FieldObject [style=dashed, label="consumes"];
}
