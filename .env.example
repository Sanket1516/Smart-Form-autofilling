# Application
APP_ENV=development
APP_NAME=Smart Form Auto-Filling System
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_BUILD_TARGET=prod
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# MongoDB
MONGODB_ROOT_USERNAME=smart_form
MONGODB_ROOT_PASSWORD=replace_with_a_local_development_password
MONGODB_DATABASE=smart_form_db
MONGODB_URL=mongodb://smart_form:replace_with_a_local_development_password@localhost:27017/?authSource=admin
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# ChromaDB
CHROMADB_PORT=8001
CHROMADB_URL=http://localhost:8001
CHROMADB_COLLECTION=user_document_chunks
CHROMADB_TENANT=default_tenant
CHROMADB_DATABASE=default_database
CHROMADB_TIMEOUT_SECONDS=2

# AI providers (not used in Phase 1)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=

# Future authentication and policy configuration (not used in Phase 1)
JWT_SECRET_KEY=replace_before_enabling_authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=chrome-extension://[a-p]{32}
MAX_UPLOAD_SIZE_MB=10
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.70
STORAGE_ROOT=./uploads
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
PROCESSING_MAX_RETRIES=2
OCR_LANGUAGE=en
OCR_RESOLUTION=150
EXTRACTION_MIN_CONFIDENCE=0.50
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

