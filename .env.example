# Copy to .env and fill in. Never commit .env.
# All values below are placeholders or safe local defaults.

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Dashboard -> API base URL (baked into the frontend at build time)
VITE_API_BASE_URL=http://localhost:8000

# --- Security (REQUIRED) -----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated dashboard origins allowed by CORS. The browser extension does
# not need an entry: it calls the API through its host permission.
CORS_ORIGINS=http://localhost:5173

# --- MongoDB (structured data, source of truth) ------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=smart_form_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500
# Only used by docker-compose to initialise the MongoDB container
MONGODB_ROOT_USERNAME=smartform
MONGODB_ROOT_PASSWORD=

# --- ChromaDB (document chunk vectors) ----------------------------------------
CHROMADB_PORT=8001
CHROMADB_URL=http://localhost:8001
CHROMADB_COLLECTION=user_document_chunks_v2
CHROMADB_TENANT=default_tenant
CHROMADB_DATABASE=default_database
CHROMADB_TIMEOUT_SECONDS=30

# --- LLM provider -------------------------------------------------------------
# One of: google | openai | anthropic | ollama | mock
# "mock" makes no network calls and returns empty AI results (pattern-based
# extraction, exact fact lookups and deterministic field matching still work).
# PRIVACY: with google/openai/anthropic, document text and form-field labels are
# sent to that provider for extraction and answers. "ollama" keeps everything on
# this machine. Exact Ask-Documents lookups never call any model.
LLM_PROVIDER=mock
# Exact model id for the chosen provider, e.g. a Gemini, GPT or Claude model id.
LLM_MODEL=
LLM_API_KEY=
# Only for LLM_PROVIDER=ollama (inside Docker: http://host.docker.internal:11434)
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# Bounded retries for timeouts, dropped connections, 429 and 5xx (never for 4xx).
LLM_MAX_RETRIES=2
# Optional fallback used when the primary provider fails (same validation rules).
# Example local fallback: LLM_FALLBACK_PROVIDER=ollama, LLM_FALLBACK_MODEL=qwen2:7b
# Field mappings chosen by the fallback always require user review.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=http://localhost:11434

# --- Embeddings ---------------------------------------------------------------
# Any sentence-transformers model id. Downloaded on first use (~90 MB for the
# default). Changing it requires a new CHROMADB_COLLECTION and a reindex.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- File storage -------------------------------------------------------------
# local | cloudinary
STORAGE_PROVIDER=local
STORAGE_ROOT=./uploads
MAX_UPLOAD_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Document processing -------------------------------------------------------
# inline: process inside the API process (no Redis needed)
# celery: queue to a Celery worker through Redis (used by docker-compose)
PROCESSING_MODE=inline
REDIS_URL=redis://localhost:6379/0
PROCESSING_STALE_AFTER_MINUTES=15
# Set to true to add PaddleOCR to the backend and worker images (large download).
INSTALL_OCR=false
# Each worker process loads its own OCR model (~1 GB RAM while reading a page).
# Keep 1 on machines where Docker has 8 GB or less.
CELERY_WORKER_CONCURRENCY=1
# paddle | none (none: scanned pages are marked "requires review")
OCR_ENGINE=paddle
# auto: upscale / contrast / orientation / deskew only when a page needs it; none: read as-is
OCR_PREPROCESS=auto
OCR_LANGUAGE=en
OCR_RESOLUTION=150
OCR_CPU_THREADS=2
LLM_EXTRACTION_MAX_CHARS=18000

# --- Retrieval (RAG) ----------------------------------------------------------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
# Chunks below this cosine similarity are ignored
RAG_MIN_SIMILARITY=0.35

# --- Form filling -------------------------------------------------------------
# Deterministic matches below this confidence are sent to the LLM classifier
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
# Recommendations below this confidence always need user review
AUTOFILL_MIN_CONFIDENCE=0.85
# Extra concepts that always need confirmation (ontology "sensitive" concepts are included automatically)
SENSITIVE_FIELD_CONCEPTS=identity.passport_number,identity.pan_number,identity.aadhaar_number,identity.national_id,financial.account_number,financial.routing_number,financial.tax_id,financial.cif_number
