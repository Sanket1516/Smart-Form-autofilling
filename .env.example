# Application
APP_ENV=development
APP_NAME=Smart Form Auto-Filling System
APP_VERSION=0.1.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# MongoDB
MONGODB_ROOT_USERNAME=smart_form
MONGODB_ROOT_PASSWORD=replace_with_a_local_development_password
MONGODB_DATABASE=smart_form_db
MONGODB_URL=mongodb://smart_form:replace_with_a_local_development_password@localhost:27017/?authSource=admin
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# ChromaDB
CHROMADB_PORT=8001
CHROMADB_URL=http://localhost:8001
CHROMADB_COLLECTION=user_document_chunks
CHROMADB_TIMEOUT_SECONDS=2

# AI providers (not used in Phase 1)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=

# Future authentication and policy configuration (not used in Phase 1)
JWT_SECRET_KEY=replace_before_enabling_authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,chrome-extension://*
MAX_UPLOAD_SIZE_MB=10
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.70

