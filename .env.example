# Application
APP_ENV=development
APP_NAME=Smart Form Auto-Filling System
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# MongoDB
MONGODB_DATABASE=smart_form_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# ChromaDB (vector database for RAG)
CHROMADB_PORT=8001
CHROMADB_URL=http://localhost:8001
CHROMADB_COLLECTION=user_document_chunks
CHROMADB_TENANT=default_tenant
CHROMADB_DATABASE=default_database
CHROMADB_TIMEOUT_SECONDS=30

# Security (REQUIRED — generate a strong random secret)
JWT_SECRET_KEY=replace_this_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=chrome-extension://[a-p]{32}

# File Storage (choose "local" or "cloudinary")
STORAGE_PROVIDER=local
STORAGE_ROOT=./uploads
MAX_UPLOAD_SIZE_MB=10

# Cloudinary (only needed when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / LLM Provider
# Supported values: google, openai, anthropic, mock (default if empty)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# Embedding Model (sentence-transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG Configuration
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
LLM_MAX_EVIDENCE_CHUNKS=5
LLM_REASONING_TIMEOUT_SECONDS=30

# Confidence Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.70
CONFIDENCE_THRESHOLD=0.85
EXTRACTION_MIN_CONFIDENCE=0.50
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50

# Document Processing
OCR_LANGUAGE=en
OCR_RESOLUTION=150

# Celery / Redis (required for background document processing)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
PROCESSING_MAX_RETRIES=2

# Sensitive field concepts (require human confirmation)
SENSITIVE_FIELD_CONCEPTS=ssn,credit_card,passport_number,password
