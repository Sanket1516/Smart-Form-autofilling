{
  "manifest_version": 3,
  "name": "Smart Form Auto-Filling System",
  "version": "0.2.0",
  "description": "Fills web forms from your verified profile and documents, only after you review and approve each value.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Smart Form Autofill"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
