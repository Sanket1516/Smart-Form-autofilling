{
  "manifest_version": 3,
  "name": "Smart Form Auto-Filling System",
  "version": "0.1.0",
  "description": "Phase 1 foundation for the Smart Form Auto-Filling System.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Form Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*"]
}
